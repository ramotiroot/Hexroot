local function enableESP(player)
    if player == LocalPlayer then return end
    local data = espData[player.Name]
    if not data or data.active then return end
    local char = player.Character
    if not char then return end
    data.active = true
    data.highlight = createHighlight(char)
    data.billboard = createBillboard(char, player)
end

local function disableESP(player)
    local data = espData[player.Name]
    if not data then return end
    data.active = false
    if data.highlight and data.highlight.Parent then data.highlight:Destroy() data.highlight = nil end
    if data.billboard and data.billboard.Parent then data.billboard:Destroy() data.billboard = nil end
end

RunService.Heartbeat:Connect(function()
    local lHRP = getHRP(LocalPlayer)
    if not lHRP then return end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local data = espData[player.Name]
            if data and data.active and data.billboard then
                local hrp = getHRP(player)
                local hum = getHum(player)
                if hrp and hum then
                    local dist = math.floor((lHRP.Position - hrp.Position).Magnitude)
                    local bg = data.billboard:FindFirstChildOfClass("Frame")
                    if not bg then continue end
                    local distLbl = bg:FindFirstChild("DistLbl")
                    if distLbl then
                        distLbl.TextColor3 = dist <= CONFIG.WARN_DIST and CONFIG.WARN or CONFIG.ACCENT3
                        distLbl.Text = dist <= CONFIG.WARN_DIST and "⚠️ "..dist.." studs" or "📍 "..dist.." studs"
                    end
                    local hpBg = bg:FindFirstChild("HpBg")
                    local hpLbl = bg:FindFirstChild("HpLbl")
                    if hpBg and hpLbl then
                        local hpFill = hpBg:FindFirstChild("HpFill")
                        local ratio = hum.MaxHealth > 0 and (hum.Health / hum.MaxHealth) or 0
                        if hpFill then
                            hpFill.BackgroundColor3 = ratio > 0.6 and CONFIG.SAFE or ratio > 0.3 and Color3.fromRGB(255,200,0) or CONFIG.WARN
                            TweenService:Create(hpFill, TweenInfo.new(0.1), {Size = UDim2.new(math.clamp(ratio,0,1),0,1,0)}):Play()
                        end
                        hpLbl.Text = "HP: "..math.floor(hum.Health).."/"..math.floor(hum.MaxHealth)
                    end
                elseif not hrp then
                    disableESP(player)
                    data.active = true
                end
            end
        end
    end
end)

