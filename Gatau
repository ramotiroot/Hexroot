    nameLbl.Text = player.Name
    nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
    nameLbl.Parent = row

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 52, 0, 26)
    toggleBtn.Position = UDim2.new(1, -60, 0.5, -13)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(35,35,50)
    toggleBtn.TextColor3 = Color3.fromRGB(130,130,160)
    toggleBtn.Font = Enum.Font.GothamBold
    toggleBtn.TextSize = 11
    toggleBtn.Text = "OFF"
    toggleBtn.BorderSizePixel = 0
    toggleBtn.Parent = row
    Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 6)

    toggleBtn.MouseButton1Click:Connect(function()
        local data = espData[player.Name]
        if not data then return end
        if data.active then
            disableESP(player)
            toggleBtn.Text = "OFF"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(35,35,50)
            toggleBtn.TextColor3 = Color3.fromRGB(130,130,160)
            dot.BackgroundColor3 = Color3.fromRGB(80,80,100)
            nameLbl.TextColor3 = Color3.fromRGB(210,210,230)
        else
            enableESP(player)
            toggleBtn.Text = "ON"
            toggleBtn.BackgroundColor3 = CONFIG.ACCENT
            toggleBtn.TextColor3 = Color3.fromRGB(255,255,255)
            dot.BackgroundColor3 = CONFIG.ACCENT
            nameLbl.TextColor3 = Color3.fromRGB(255,255,255)
        end
    end)

    player.CharacterAdded:Connect(function()
        local data = espData[player.Name]
        if data and data.active then
            task.wait(0.5)
            enableESP(player)
        end
    end)

    playerRows[player.Name] = row
end

local function removePlayerRow(player)
    disableESP(player)
    espData[player.Name] = nil
    local row = playerRows[player.Name]
    if row then row:Destroy() playerRows[player.Name] = nil end
end

for _, player in pairs(Players:GetPlayers()) do createPlayerRow(player) end
Players.PlayerAdded:Connect(createPlayerRow)
Players.PlayerRemoving:Connect(removePlayerRow)

