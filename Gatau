local function createSideTab(name, icon, color, order)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(1, 0, 0, 38)
    btn.BackgroundColor3 = CONFIG.BG3
    btn.TextColor3 = Color3.fromRGB(140,140,170)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Text = icon.."  "..name
    btn.BorderSizePixel = 0
    btn.LayoutOrder = order
    btn.Parent = sidebar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local indicator = Instance.new("Frame")
    indicator.Name = "Indicator"
    indicator.Size = UDim2.new(0, 3, 0.6, 0)
    indicator.Position = UDim2.new(0, 0, 0.2, 0)
    indicator.BackgroundColor3 = color
    indicator.BorderSizePixel = 0
    indicator.Visible = false
    indicator.Parent = btn
    Instance.new("UICorner", indicator).CornerRadius = UDim.new(0, 2)

    local frame = Instance.new("Frame")
    frame.Name = name.."Frame"
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundTransparency = 1
    frame.Visible = false
    frame.Parent = contentArea

    tabs[name] = frame
    tabBtns[name] = { btn = btn, color = color, indicator = indicator }
    return frame, btn
end

local function switchTab(name)
    for tName, data in pairs(tabBtns) do
        tabs[tName].Visible = false
        data.btn.BackgroundColor3 = CONFIG.BG3
        data.btn.TextColor3 = Color3.fromRGB(140,140,170)
        data.indicator.Visible = false
    end
    tabs[name].Visible = true
    local d = tabBtns[name]
    d.btn.BackgroundColor3 = Color3.fromRGB(25, 25, 38)
    d.btn.TextColor3 = d.color
    d.indicator.Visible = true
end

