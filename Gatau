local function setSpeed(speed)
    speed = math.clamp(math.floor(speed), CONFIG.DEFAULT_SPD, CONFIG.MAX_SPD)
    currentSpeed = speed
    local ratio = (speed - CONFIG.DEFAULT_SPD) / (CONFIG.MAX_SPD - CONFIG.DEFAULT_SPD)
    TweenService:Create(sliderFill, TweenInfo.new(0.05), {Size = UDim2.new(ratio, 0, 1, 0)}):Play()
    sliderKnob.Position = UDim2.new(ratio, 0, 0.5, 0)
    speedValueLbl.Text = "Speed: "..speed
    if speed >= CONFIG.MAX_SPD then
        modeLbl.Text = "⚡ Awaken"
        modeLbl.TextColor3 = CONFIG.WARN
        sliderFill.BackgroundColor3 = CONFIG.WARN
        knobStroke.Color = CONFIG.WARN
    elseif speed > CONFIG.DEFAULT_SPD then
        modeLbl.Text = "▲ Boosted"
        modeLbl.TextColor3 = CONFIG.ACCENT3
        sliderFill.BackgroundColor3 = CONFIG.ACCENT3
        knobStroke.Color = CONFIG.ACCENT3
    else
        modeLbl.Text = "● Normal"
        modeLbl.TextColor3 = CONFIG.SAFE
        sliderFill.BackgroundColor3 = CONFIG.SAFE
        knobStroke.Color = CONFIG.ACCENT
    end
    local hum = getHum(LocalPlayer)
    if hum then hum.WalkSpeed = speed end
end

